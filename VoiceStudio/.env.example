# Google Gemini API Keys for Text-to-Speech (Failover System)
# Provide your keys below. The backend automatically fails over from Key 1 -> Key 2 -> Key 3.
# In AI Studio, the system key is also supported automatically.
GEMINI_API_KEY_1=your_first_key_here
GEMINI_API_KEY_2=your_second_key_here
GEMINI_API_KEY_3=your_third_key_here

# Server Configuration
PORT=3000

# Optional TTS Model override (default is gemini-3.8-flash-tts)
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

